# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Base de datos PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<base-de-datos>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Puerto del host en el que se publica el contenedor (solo en 127.0.0.1).
APP_PORT=8099

APP_SCRAPER_TIMEOUT_MS=30000

APP_SOURCES_RUI_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
APP_SOURCES_RUES_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"

# Límite de consultas a /api/lookup (0 desactiva un límite).
APP_RATE_LIMIT_PER_CLIENT_PER_MINUTE=10
APP_RATE_LIMIT_PER_CLIENT_PER_DAY=200
APP_RATE_LIMIT_GLOBAL_PER_MINUTE=60
